generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model IntelligenceBrief {
  id         String      @id @default(cuid())
  createdAt  DateTime    @default(now())
  keywords   String
  site       String
  data       String
  workOrders WorkOrder[]
}

model WorkOrder {
  id             String            @id @default(cuid())
  briefId        String
  brief          IntelligenceBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  type           String
  title          String
  description    String
  evidence       String
  expectedResult String
  targetFile     String?
  status         String            @default("pending")
  diff           String?
  commitSha      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}
